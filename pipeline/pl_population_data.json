{
	"name": "pl_population_data",
	"properties": {
		"activities": [
			{
				"name": "Population Transformation",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/crvalvilabs@outlook.com/covid/population/population_transform"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks_covid",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Population Error",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Population Transformation",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Population Transformation').output.message",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Population Transformation').output.code",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Metadata",
				"description": "Get metadata from the file population.csv",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Population Transformation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_staging_population",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"structure"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			}
		],
		"folder": {
			"name": "PopulationByAge"
		},
		"annotations": []
	}
}
{
	"name": "pl_bronze_ingest_population",
	"properties": {
		"description": "Ingest data",
		"activities": [
			{
				"name": "Copy data to bronze",
				"description": "Copy data to bronze layer",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "vDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 300,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_bronze_population_by_age_gz",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_bronze_population_by_age",
						"type": "DatasetReference",
						"parameters": {
							"pFolderName": {
								"value": "@variables('vDate')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Get Metadata1",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Copy data to bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": []
			},
			{
				"name": "Find File",
				"description": "Activity to validate the existence of the file",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 300,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_bronze_population_by_age_gz",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "File error",
				"description": "Register a fail message",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Find File",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Find File').output",
						"type": "Expression"
					},
					"errorCode": "404"
				}
			},
			{
				"name": "Fail2",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Copy data to bronze",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": []
			},
			{
				"name": "vDate",
				"description": "Get de datetime in string format",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Find File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vDate",
					"value": {
						"value": "@concat('population/', string(formatDateTime(utcNow(), 'yyyy-MM-dd')))",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"vDate": {
				"type": "String"
			}
		},
		"annotations": []
	}
}
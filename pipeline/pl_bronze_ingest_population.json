{
	"name": "pl_bronze_ingest_population",
	"properties": {
		"description": "Ingest data",
		"activities": [
			{
				"name": "Get Metadata",
				"description": "Get Metadata to validate the copy data",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "vDate",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 360,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_bronze_population_by_age_gz",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"columnCount"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Find File",
				"description": "Activity to validate the existence of the file",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 300,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_bronze_population_by_age_gz",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "vDate",
				"description": "Get de datetime in string format",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Find File",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vDate",
					"value": {
						"value": "@concat('population/', string(formatDateTime(utcNow(), 'yyyy-MM-dd')))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "If Condition",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get Metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(activity('Get Metadata').output.columnCount, 13), activity('Get Metadata').output.exists)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Web",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": "https://www.enviodecorreo.com",
								"body": {
									"value": "@variables('ErrorMessage')",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy data to bronze",
							"description": "Copy data to bronze layer",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 300,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobStorageReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_bronze_population_by_age_gz",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze_population_by_age",
									"type": "DatasetReference",
									"parameters": {
										"pFolderName": {
											"value": "@variables('vDate')",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Copy Fail",
							"description": "Register a error message during copy data",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Copy data to bronze",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@activity('Copy data to bronze').output.message",
									"type": "Expression"
								},
								"errorCode": {
									"value": "@activity('Copy data to bronze').output.code",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Set ErrorMessage",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Copy Fail",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "ErrorMessage",
								"value": {
									"value": "@intersection(activity('Copy Fail').output.code, activity('Copy Fail').output.code)",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"vDate": {
				"type": "String"
			},
			"ErrorMessage": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "Ingest"
		},
		"annotations": []
	}
}
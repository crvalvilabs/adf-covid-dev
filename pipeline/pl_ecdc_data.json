{
	"name": "pl_ecdc_data",
	"properties": {
		"activities": [
			{
				"name": "File Lookup Error",
				"description": "Shows the error message and code",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Lookup",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Lookup').output.message",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Lookup').output.code",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Lookup",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_landing_ecdc_config",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data from ECDC",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_landing_http_ecdc",
									"type": "DatasetReference",
									"parameters": {
										"pRelativeUrl": {
											"value": "@item().sourceRelativeURL",
											"type": "Expression"
										},
										"pSourceBaseUrl": {
											"value": "@item().sourceBaseURL",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze_ecdc_csv",
									"type": "DatasetReference",
									"parameters": {
										"pFileName": {
											"value": "@item().sinkFileName",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Validation",
							"type": "Validation",
							"dependsOn": [
								{
									"activity": "Copy data from ECDC",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_bronze_ecdc_csv",
									"type": "DatasetReference",
									"parameters": {
										"pFileName": {
											"value": "@item().sinkFileName",
											"type": "Expression"
										}
									}
								},
								"timeout": "0.00:10:00",
								"sleep": 10
							}
						},
						{
							"name": "Fail Copy data",
							"type": "Fail",
							"dependsOn": [
								{
									"activity": "Copy data from ECDC",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"message": "Error copy data to sink",
								"errorCode": "500"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pRelativeUrl": {
				"type": "string"
			},
			"pFileName": {
				"type": "string"
			},
			"pSourceBaseUrl": {
				"type": "string"
			}
		},
		"variables": {
			"vFiles": {
				"type": "String"
			}
		},
		"folder": {
			"name": "Ingest"
		},
		"annotations": []
	}
}
{
	"name": "df_testing_staging_silver",
	"properties": {
		"folder": {
			"name": "Testing"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_staging_testing",
						"type": "DatasetReference"
					},
					"name": "TestingStagingSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_testing",
						"type": "DatasetReference"
					},
					"name": "TestingSilverSink"
				}
			],
			"transformations": [
				{
					"name": "RenameColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          country as string,",
				"          country_code_2_digit as string,",
				"          country_code_3_digit as string,",
				"          year_week as string,",
				"          week_start as date,",
				"          week_end as date,",
				"          new_cases as integer,",
				"          tests_done as integer,",
				"          population as integer,",
				"          testing_data_source as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['ecdc/testing/testing.csv']) ~> TestingStagingSource",
				"TestingStagingSource select(mapColumn(",
				"          country,",
				"          country_code_2_digit,",
				"          country_code_3_digit,",
				"          year_week,",
				"          week_start_date = week_start,",
				"          week_end_date = week_end,",
				"          new_cases,",
				"          tests_done,",
				"          population,",
				"          testing_data_source",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns",
				"RenameColumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          country as string,",
				"          country_code_3_digit as string,",
				"          country_code_2_digit as string,",
				"          population as integer,",
				"          source as string,",
				"          reported_date as date,",
				"          cases_count as integer,",
				"          deaths_count as short",
				"     ),",
				"     format: 'parquet',",
				"     partitionFileNames:['testing_silver.parquet'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> TestingSilverSink"
			]
		}
	}
}
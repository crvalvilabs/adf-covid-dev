{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-health-dev"
		},
		"ls_blob_covid_reporting_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_blob_covid_reporting'"
		},
		"ls_databricks_covid_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_databricks_covid'"
		},
		"ls_dl_covid_reports_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dl_covid_reports'"
		},
		"sql_covid_dev_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'sql_covid_dev'"
		},
		"ls_databricks_covid_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1108-195709-ib22jogy"
		},
		"ls_dl_covid_reports_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlcovidreports.dfs.core.windows.net/"
		},
		"ls_http_opendata_ecdc_europa_eu_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().pSourceUrl}"
		},
		"sql_covid_dev_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-covid-dev.database.windows.net"
		},
		"sql_covid_dev_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-covid"
		},
		"sql_covid_dev_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"tggr_population_ingest_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/88e694b8-ae19-43de-807e-fee3c629047a/resourceGroups/rg-covid-data-dev-eastus/providers/Microsoft.Storage/storageAccounts/stcovidreporting"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-health-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_blob_covid_reporting_connectionString": {
						"value": "[parameters('ls_blob_covid_reporting_connectionString')]"
					},
					"ls_databricks_covid_accessToken": {
						"value": "[parameters('ls_databricks_covid_accessToken')]"
					},
					"ls_dl_covid_reports_accountKey": {
						"value": "[parameters('ls_dl_covid_reports_accountKey')]"
					},
					"sql_covid_dev_password": {
						"value": "[parameters('sql_covid_dev_password')]"
					},
					"ls_databricks_covid_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_databricks_covid_properties_typeProperties_existingClusterId')]"
					},
					"ls_dl_covid_reports_properties_typeProperties_url": {
						"value": "[parameters('ls_dl_covid_reports_properties_typeProperties_url')]"
					},
					"ls_http_opendata_ecdc_europa_eu_properties_typeProperties_url": {
						"value": "[parameters('ls_http_opendata_ecdc_europa_eu_properties_typeProperties_url')]"
					},
					"sql_covid_dev_properties_typeProperties_server": {
						"value": "[parameters('sql_covid_dev_properties_typeProperties_server')]"
					},
					"sql_covid_dev_properties_typeProperties_database": {
						"value": "[parameters('sql_covid_dev_properties_typeProperties_database')]"
					},
					"sql_covid_dev_properties_typeProperties_userName": {
						"value": "[parameters('sql_covid_dev_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-health-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-health-dev_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf-health-dev_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"tggr_population_ingest_properties_typeProperties_scope": {
						"value": "[parameters('tggr_population_ingest_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-health-dev_ArmTemplate_1')]"
			]
		}
	]
}
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> PopulationSource",
						"PopulationSource sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['population_by_age_bronze.tsv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",

					"scriptLines": [
						"source(output(",
						"          country as string,",
						"          country_code as string,",
						"          country_code_2_digit as string,",
						"          population as integer,",
						"          source as string,",
						"          reported_date as date,",
						"          {confirmed cases_count} as integer,",
						"          deaths_count as short",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> CasesDeathsStagingFlow",
						"CasesDeathsStagingFlow select(mapColumn(",
						"          country,",
						"          country_code_3_digit = country_code,",
						"          country_code_2_digit,",
						"          population,",
						"          source,",
						"          reported_date,",
						"          cases_count = {confirmed cases_count},",
						"          deaths_count",
						"     ),",
						"     partitionBy('hash', 1),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> RenameConfirmedCases",
						"RenameConfirmedCases sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     partitionFileNames:['cases_deaths_silver.parquet'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> SilverSink"
					]
				}
			},
			"dependsOn": [

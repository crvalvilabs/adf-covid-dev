		{
			"name": "[concat(parameters('factoryName'), '/df_cases_deaths_bronze_to_staging')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "CasesDeaths"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_cases_deaths",
								"type": "DatasetReference"
							},
							"name": "CasesDeathsSource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_staging_cases_deaths",
								"type": "DatasetReference"
							},
							"name": "CasesAndDeathsSink"
						}
					],
					"transformations": [
						{
							"name": "DropAndRenameColumns",
							"description": "DropAndRenameColumns with columns 'country, country_code_2_digit, country_code, population, indicator, daily_count, source, reported_date'"
						},
						{
							"name": "AddColumnCountry"
						},
						{
							"name": "PivotCounts"
						},
						{
							"name": "ContinentFilter"
						}
					],
					"scriptLines": [
						"source(output(",
						"          country as string,",
						"          country_code as string,",
						"          continent as string,",
						"          population as integer,",
						"          indicator as string,",
						"          daily_count as short,",
						"          date as date,",
						"          rate_14_day as double,",
						"          source as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> CasesDeathsSource",
						"AddColumnCountry select(mapColumn(",
						"          country,",
						"          country_code_3_digit = country_code,",
						"          country_code_2_digit,",
						"          population,",
						"          indicator,",
						"          daily_count,",
						"          source,",
						"          each(match(name=='date'),",
						"               'reported'+'_date' = $$)",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> DropAndRenameColumns",
						"ContinentFilter derive(country_code_2_digit = substring(country_code, 1, 2)) ~> AddColumnCountry",
						"DropAndRenameColumns pivot(groupBy(country,",
						"          country_code_3_digit,",
						"          country_code_2_digit,",
						"          population,",
						"          source,",
						"          reported_date),",
						"     pivotBy(indicator, ['confirmed cases', 'deaths']),",
						"     count = sum(daily_count),",
						"     columnNaming: '$V_$N',",
						"     lateral: false) ~> PivotCounts",
						"CasesDeathsSource filter(trim(continent) == 'Europe') ~> ContinentFilter",
						"PivotCounts sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['cases_deaths_staging.csv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> CasesAndDeathsSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_staging_cases_deaths')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_cases_deaths_staging_to_silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
